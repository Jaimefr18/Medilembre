{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm --filter @medilembre/web build && pnpm --filter @medilembre/api build",
  "services": {
    "api": {
      "root": "apps/api",
      "framework": "fastify"
    },
    "web": {
      "root": "apps/web",
      "framework": "sveltekit-1",
      "bindings": [
        {
          "type": "service",
          "service": "api",
          "format": "url",
          "env": "API_URL"
        }
      ]
    },
    "worker": {
      "root": "apps/worker",
      "runtime": "container"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": { "service": "api" }
    },
    {
      "source": "/(.*)",
      "destination": { "service": "web" }
    }
  ]
}
