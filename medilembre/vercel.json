{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "api": {
      "root": "apps/api",
      "framework": "fastify",
      "installCommand": "cd ../.. && pnpm install --frozen-lockfile --filter @medilembre/api...",
      "buildCommand": "pnpm build"
    },
    "web": {
      "root": "apps/web",
      "framework": "sveltekit-1",
      "installCommand": "cd ../.. && pnpm install --frozen-lockfile --filter @medilembre/web...",
      "buildCommand": "pnpm build",
      "outputDirectory": "build",
      "rewrites": [
        {
          "source": "/(.*)",
          "destination": "/404.html"
        }
      ]
    },
    "worker": {
      "root": ".",
      "runtime": "container",
      "entrypoint": "Dockerfile.worker"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": { "service": "api" }
    },
    {
      "source": "/(.*)",
      "destination": { "service": "web" }
    }
  ]
}
