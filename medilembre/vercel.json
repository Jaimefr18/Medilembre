{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm --filter @medilembre/web build && pnpm --filter @medilembre/api build",
  "services": {
    "web": {
      "root": "apps/web"
    },
    "api": {
      "root": "apps/api",
      "entrypoint": "src/index.ts"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": { "service": "api" }
    },
    {
      "source": "/(.*)",
      "destination": { "service": "web" }
    }
  ],
  "daemons": {
    "worker": {
      "root": "apps/worker",
      "entrypoint": "Dockerfile",
      "instances": {
        "iad1": 1
      },
      "resources": {
        "requests": {
          "memory": "2Gi"
        }
      },
      "terminationGracePeriodSeconds": 10,
      "livenessProbe": {
        "httpGet": {
          "port": 3001,
          "path": "/health"
        }
      }
    }
  }
}
