# Copia para .env (nunca fazer commit do .env)
POSTGRES_PASSWORD=medilembre
APP_DB_PASSWORD=app
# Utilizador dono do schema (migrações e worker, ignora RLS)
DATABASE_URL_ADMIN=postgres://medilembre:medilembre@localhost:5432/medilembre
# Utilizador da API (sujeito a RLS)
DATABASE_URL=postgres://medilembre_app:app@localhost:5432/medilembre
PORT=3000
NODE_ENV=development
# Gera com: pnpm vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tu@exemplo.com
