<file path="db/migrations/0001_init.sql">
-- MediLembre: schema inicial + RLS por pharmacy_id
create extension if not exists pgcrypto;

do $$ begin
  if not exists (select 1 from pg_roles where rolname = 'medilembre_app') then
    create role medilembre_app login;
  end if;
end $$;

create table pharmacies (
  id uuid primary key default gen_random_uuid(),
  name text not null, nif text, phone text,
  status text not null default 'trial',
  timezone text not null default 'Africa/Luanda',
  created_at timestamptz not null default now()
);

-- pharmacy_users e sessions: consultadas no login, antes de existir tenant -> sem RLS (só o módulo auth lhes toca)
create table pharmacy_users (
  id uuid primary key default gen_random_uuid(),
  pharmacy_id uuid not null references pharmacies on delete cascade,
  name text not null, email text not null unique,
  role text not null default 'pharmacist' check (role in ('admin','pharmacist')),
  password_hash text not null
);
create table sessions (
  id text primary key,
  user_id uuid not null references pharmacy_users on delete cascade,
  expires_at timestamptz not null,
  created_at timestamptz not null default now()
);

create table customers (
  id uuid primary key default gen_random_uuid(),
  pharmacy_id uuid not null references pharmacies on delete cascade,
  name text not null, phone text, email text,
  status text not null default 'active'
);
create table medication_plans (
  id uuid primary key default gen_random_uuid(),
  pharmacy_id uuid not null references pharmacies on delete cascade,
  customer_id uuid not null references customers on delete cascade,
  start_date date not null, end_date date not null,
  status text not null default 'rascunho'
);
create table plan_items (
  id uuid primary key default gen_random_uuid(),
  pharmacy_id uuid not null references pharmacies on delete cascade,
  plan_id uuid not null references medication_plans on delete cascade,
  medication text not null, dosage text,
  schedule_rule text not null default 'daily',
  times_local time[] not null
);
create table reminders (
  id uuid primary key default gen_random_uuid(),
  pharmacy_id uuid not null references pharmacies on delete cascade,
  plan_item_id uuid not null references plan_items on delete cascade,
  due_at_utc timestamptz not null,
  status text not null default 'pending',
  confirmed_at timestamptz,
  unique (plan_item_id, due_at_utc)
);
create index reminders_due_idx on reminders (status, due_at_utc);
create table activation_tokens (
  id uuid primary key default gen_random_uuid(),
  pharmacy_id uuid not null references pharmacies on delete cascade,
  plan_id uuid not null references medication_plans on delete cascade,
  token_hash text not null unique,
  expires_at timestamptz not null, used_at timestamptz
);
create table consents (
  id uuid primary key default gen_random_uuid(),
  pharmacy_id uuid not null references pharmacies on delete cascade,
  customer_id uuid not null references customers on delete cascade,
  type text not null, granted boolean not null, granted_at timestamptz not null default now()
);
create table push_subscriptions (
  id uuid primary key default gen_random_uuid(),
  pharmacy_id uuid not null references pharmacies on delete cascade,
  customer_id uuid not null references customers on delete cascade,
  endpoint text not null unique, p256dh text not null, auth text not null,
  platform text, last_ok_at timestamptz
);
create table reservations (
  id uuid primary key default gen_random_uuid(),
  pharmacy_id uuid not null references pharmacies on delete cascade,
  customer_id uuid not null references customers on delete cascade,
  plan_id uuid references medication_plans,
  status text not null default 'pending',
  requested_at timestamptz not null default now(), decided_at timestamptz
);
create table delivery_logs (
  id uuid primary key default gen_random_uuid(),
  pharmacy_id uuid not null references pharmacies on delete cascade,
  reminder_id uuid not null references reminders on delete cascade,
  channel text not null, result text not null, attempted_at timestamptz not null default now()
);
create table audit_log (
  id uuid primary key default gen_random_uuid(),
  pharmacy_id uuid not null references pharmacies on delete cascade,
  actor text not null, action text not null, at timestamptz not null default now()
);

-- Spike de Web Push (dias 2-3). Sem dados pessoais; apagar depois do go/no-go.
create table spike_subscriptions (
  id uuid primary key default gen_random_uuid(),
  endpoint text not null unique, p256dh text not null, auth text not null,
  user_agent text, created_at timestamptz not null default now()
);
create table spike_jobs (
  id uuid primary key default gen_random_uuid(),
  subscription_id uuid not null references spike_subscriptions on delete cascade,
  label text, due_at timestamptz not null, sent_at timestamptz, result text
);

-- RLS: a API define app.pharmacy_id por transação; sem isso, zero linhas.
alter table pharmacies enable row level security;
alter table pharmacies force row level security;
create policy tenant on pharmacies
  using (id = nullif(current_setting('app.pharmacy_id', true), '')::uuid);

do $$
declare t text;
begin
  foreach t in array array['customers','medication_plans','plan_items','reminders','activation_tokens',
    'consents','push_subscriptions','reservations','delivery_logs','audit_log'] loop
    execute format('alter table %I enable row level security', t);
    execute format('alter table %I force row level security', t);
    execute format($p$create policy tenant on %I
      using (pharmacy_id = nullif(current_setting('app.pharmacy_id', true), '')::uuid)
      with check (pharmacy_id = nullif(current_setting('app.pharmacy_id', true), '')::uuid)$p$, t);
  end loop;
end $$;

grant usage on schema public to medilembre_app;
grant select, insert, update, delete on all tables in schema public to medilembre_app;
</file>

<file path="db/migrations/0002_client_app.sql">
-- MediLembre · app do cliente: login, sessões, lembretes, reservas, push.
-- Requer 0001_init.sql (pharmacies, customers, role medilembre_app).
-- Prefixo client_ APENAS nas 4 tabelas que colidiam com o 0001 (sessions, reminders,
-- reservations, push_subscriptions). As restantes mantêm o nome: já são específicas do domínio.
-- Sem "if not exists": se alguma tabela já existir, a migração deve falhar alto em vez de
-- ficar calada com a definição antiga.

-- Tabelas de autenticação: sem RLS (são lidas ANTES de saber a farmácia). Só guardam hashes.
create table customer_logins (
  customer_id   uuid primary key references customers(id) on delete cascade,
  pharmacy_id   uuid not null references pharmacies(id),
  identifier    text not null unique,            -- telemóvel normalizado (244...) ou email em minúsculas
  password_hash text not null,                   -- argon2id
  created_at    timestamptz not null default now()
);

create table client_sessions (
  id_hash     bytea primary key,                 -- sha256 do token do cookie (o token nunca é guardado)
  customer_id uuid not null references customers(id) on delete cascade,
  pharmacy_id uuid not null,
  user_agent  text,
  created_at  timestamptz not null default now(),
  expires_at  timestamptz not null
);
create index client_sessions_expires_idx on client_sessions (expires_at);

create table activation_codes (
  code_hash   bytea primary key,                 -- sha256 do código do QR
  customer_id uuid not null references customers(id) on delete cascade,
  pharmacy_id uuid not null,
  expires_at  timestamptz not null,
  used_at     timestamptz
);

-- Tabelas de dados: RLS por farmácia (+ por cliente quando a app do cliente corre).
create table pharmacy_products (
  id          uuid primary key default gen_random_uuid(),
  pharmacy_id uuid not null references pharmacies(id),
  name        text not null,
  pack        text not null default '',
  active      boolean not null default true
);

-- Não confundir com `reminders` do 0001 (ligado a plan_items). Unificação adiada.
create table client_reminders (
  id          uuid primary key default gen_random_uuid(),
  pharmacy_id uuid not null references pharmacies(id),
  customer_id uuid not null references customers(id) on delete cascade,
  name        text not null check (length(name) between 1 and 80),
  dose        text not null default '' check (length(dose) <= 80),
  at_time     time not null,
  active      boolean not null default true,
  created_at  timestamptz not null default now()
);
create index client_reminders_customer_idx on client_reminders (customer_id, at_time);

create table dose_logs (
  id          uuid primary key default gen_random_uuid(),
  pharmacy_id uuid not null,
  reminder_id uuid not null references client_reminders(id) on delete cascade,
  customer_id uuid not null references customers(id) on delete cascade,
  day         date not null,                     -- dia em Africa/Luanda
  taken_at    timestamptz not null default now(),
  unique (reminder_id, day)
);

-- Não confundir com `reservations` do 0001 (ligado a plan_id).
create table client_reservations (
  id          uuid primary key default gen_random_uuid(),
  pharmacy_id uuid not null,
  customer_id uuid not null references customers(id) on delete cascade,
  product_id  uuid not null references pharmacy_products(id),
  status      text not null default 'pendente'
              check (status in ('pendente','confirmada','recusada','cancelada')),
  created_at  timestamptz not null default now()
);
create unique index client_reservations_open_idx
  on client_reservations (customer_id, product_id) where status = 'pendente';

-- Não confundir com `push_subscriptions` do 0001 (ligado a customer + plano da farmácia).
create table client_push_subscriptions (
  id          uuid primary key default gen_random_uuid(),
  pharmacy_id uuid not null,
  customer_id uuid not null references customers(id) on delete cascade,
  endpoint    text not null unique,
  p256dh      text not null,
  auth        text not null,
  user_agent  text,
  created_at  timestamptz not null default now()
);

do $$
declare t text;
begin
  foreach t in array array['pharmacy_products','client_reminders','dose_logs','client_reservations','client_push_subscriptions'] loop
    execute format('alter table %I enable row level security', t);
    execute format('alter table %I force row level security', t);
    execute format($p$create policy tenant on %I
      using (pharmacy_id = nullif(current_setting('app.pharmacy_id', true), '')::uuid)
      with check (pharmacy_id = nullif(current_setting('app.pharmacy_id', true), '')::uuid)$p$, t);
  end loop;
  -- Restritiva: quando app.customer_id está definido, o cliente só vê as suas linhas.
  -- O painel da farmácia (sem app.customer_id) continua a ver a farmácia toda.
  foreach t in array array['client_reminders','dose_logs','client_reservations','client_push_subscriptions'] loop
    execute format($p$create policy own_customer on %I as restrictive
      using (nullif(current_setting('app.customer_id', true), '') is null
             or customer_id = nullif(current_setting('app.customer_id', true), '')::uuid)$p$, t);
  end loop;
end $$;

-- O grant do 0001 só cobriu as tabelas que existiam nesse momento. Sem isto, a API
-- (role medilembre_app) falha com "permission denied for table ...".
grant select, insert, update, delete on
  customer_logins, client_sessions, activation_codes, pharmacy_products,
  client_reminders, dose_logs, client_reservations, client_push_subscriptions
to medilembre_app;
</file>

<file path="db/migrations/0004_client_reminder_sends.sql">
-- MediLembre · envio de lembretes do cliente (um registo por lembrete e por dia).
-- Escrito só pelo worker (role admin, que ignora RLS). A API (medilembre_app) não tem acesso:
-- por isso não há GRANT. RLS fica ativa por defesa em profundidade.
create table client_reminder_sends (
  id              uuid primary key default gen_random_uuid(),
  pharmacy_id     uuid not null references pharmacies(id),
  reminder_id     uuid not null references client_reminders(id) on delete cascade,
  customer_id     uuid not null references customers(id) on delete cascade,
  day             date not null,                 -- dia local da farmácia
  due_at          timestamptz not null,          -- instante exato (UTC) do lembrete
  status          text not null default 'pending'
                  check (status in ('pending','sent','failed','skipped','no_subscription','expired')),
  attempts        int  not null default 0,
  next_attempt_at timestamptz not null default now(),
  last_error      text,
  sent_at         timestamptz,
  created_at      timestamptz not null default now(),
  unique (reminder_id, day)                      -- idempotência: nunca duas vezes no mesmo dia
);
create index client_reminder_sends_pending_idx
  on client_reminder_sends (next_attempt_at) where status = 'pending';

alter table client_reminder_sends enable row level security;
alter table client_reminder_sends force row level security;
create policy tenant on client_reminder_sends
  using (pharmacy_id = nullif(current_setting('app.pharmacy_id', true), '')::uuid)
  with check (pharmacy_id = nullif(current_setting('app.pharmacy_id', true), '')::uuid);
